{
  "schemaVersion": 1,
  "id": "legacyparkourcompat",
  "version": "${version}",
  "name": "Legacy Parkour Compat",
  "description": "Emulate historical Minecraft player movement on modern clients and servers.",
  "authors": [
    "JustAlittleWolf"
  ],
  "contact": {
    "sources": "https://github.com/JustAlittleWolf/LegacyParkourCompat",
    "issues": "https://github.com/JustAlittleWolf/LegacyParkourCompat/issues"
  },
  "icon": "assets/legacyparkourcompat/icon.png",
  "license": "MIT",
  "environment": "*",
  "mixins": [
    "legacyparkourcompat.mixins.json",
    {
      "config": "legacyparkourcompat.client.mixins.json",
      "environment": "client"
    }
  ],
  "entrypoints": {
    "main": [
      "me.wolfii.legacyparkourcompat.LegacyParkourCompat"
    ],
    "client": [
      "me.wolfii.legacyparkourcompat.LegacyParkourCompatClient"
    ],
    "server": [
      "me.wolfii.legacyparkourcompat.LegacyParkourCompatServer"
    ],
    "modmenu": [
      "me.wolfii.legacyparkourcompat.config.ModMenuIntegration"
    ],
    "legacyparkourcompat:movement-change": [
      "me.wolfii.legacyparkourcompat.change.v1_18_2.MovementChanges",
      "me.wolfii.legacyparkourcompat.change.v1_19.MovementChanges",
      "me.wolfii.legacyparkourcompat.change.v1_19_4.MovementChanges"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version}"
  },
  "suggests": {
    "modmenu": "*",
    "viaversion": "*",
    "viafabric": "*",
    "viafabricplus": "*"
  },
  "custom": {
    "legacyparkourcompat:movement-change": "Register MovementChangeProvider implementations to add versioned movement deltas."
  }
}
