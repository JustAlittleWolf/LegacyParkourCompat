+package me.wolfii.legacyparkourcompat.mechanic.hook.entity;
+
+import me.wolfii.legacyparkourcompat.mechanic.VersionedMechanic;
+import me.wolfii.legacyparkourcompat.mechanic.MechanicType;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.Vec3;
+
+import java.util.List;
+import java.util.function.BiConsumer;
+
+/**
+ * Controls candidate bounds and recorded-movement traversal for the entity
+ * inside-block callback scan.
+ *
+ * <p>Source: exact Minecraft 1.21.2 and 1.21.3 Mojmap, {@code Entity.java},
+ * {@code applyEffectsFromBlocks(Vec3, Vec3)} and {@code checkInsideBlocks};
+ * the corresponding complete files are byte-identical in these releases.
+ */
+@MechanicType("entity.inside-blocks.scan")
+public interface EntityInsideBlocksScanHook extends VersionedMechanic {
+    /**
+     * Visits the live movement records in their existing order with one query
+     * box derived from the entity's final bounding box, then clears that list
+     * after all visits return normally.
+     *
+     * <p>The callback is where the caller performs each movement's block scan.
+     * It receives the same query-box object for every movement.
+     */
+    <M> void scanMovements(AABB finalEntityBox, List<M> movements, BiConsumer<M, AABB> scanMovement);
+
+    /**
+     * Returns candidate block cells for one recorded movement and its shared
+     * candidate query box.
+     */
+    Iterable<BlockPos> candidateCells(Vec3 from, Vec3 to, AABB queryBox);
+}
