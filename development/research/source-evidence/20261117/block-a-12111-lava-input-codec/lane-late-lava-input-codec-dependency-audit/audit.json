  "verdict": {
    "status": "verified_with_scope_limit",
    "claims": [
      {
        "claim": "For otherwise-valid 1.21.11 DimensionType JSON decoded by the vanilla resource path, unrecognized top-level ultrawarm is ignored by the record codec and is not translated or retained.",
        "result": "verified",
        "evidence": "RegistryDataLoader resource path uses RegistryOps.create(JsonOps.INSTANCE,...), then direct decoder parse; DFU JsonOps.INSTANCE has compressMaps=false; MapCodecCodec -> MapDecoder map path calls named field decoders; they read only requested keys; no unknown-key rejection or remainder scan in the decode path."
      },
      {
        "claim": "Omitting attributes makes the decoded DimensionType attributes equal EnvironmentAttributeMap.EMPTY.",
        "result": "verified",
        "evidence": "DimensionType.createDirectCodec uses optionalFieldOf(attributes, EMPTY); OptionalFieldCodec returns Optional.empty on missing key and Codec optionalFieldOf mapping applies default."
      },
      {
        "claim": "FAST_LAVA default is false when no FAST_LAVA value/layer overrides it.",
        "result": "verified_narrowly",
        "evidence": "EnvironmentAttributes registers Boolean default false; EnvironmentAttributeSystem uses attribute.defaultValue when no sampler exists. An empty DimensionType attribute map supplies no dimension FAST_LAVA entry. This codec result does not establish other world layers/pack-provided overrides."
      },
      {
        "claim": "Conditional input with ultrawarm=true and omitted attributes can decode successfully.",
        "result": "verified_conditionally",
        "evidence": "Only if every required DimensionType field, field codec, registry reference, numeric range and record constructor invariant is otherwise valid; unknown ultrawarm does not affect decode."
      }
    ],
    "scope": "Exact direct 1.21.11 JSON codec behavior only. No legacy-to-modern migration, data-pack contents, effective world attribute composition, or runtime parity established."
  }
