+++ b/src/client/java/me/wolfii/legacyparkourcompat/mechanic/hook/shape/CollisionQueryShapeHook.java
@@ -0,0 +1,45 @@
+package me.wolfii.legacyparkourcompat.mechanic.hook.shape;
+
+import me.wolfii.legacyparkourcompat.mechanic.MechanicType;
+import me.wolfii.legacyparkourcompat.mechanic.VersionedMechanic;
+import net.minecraft.world.phys.AABB;
+
+import java.util.Optional;
+
+/**
+ * Supplies the historical encoding used for an entity's swept block-collision query.
+ * The returned description must be materialized by the runtime using the native
+ * VoxelShape implementation; this hook deliberately does not construct shapes.
+ * An empty result requests native fallback. Callers must apply this operation only
+ * for the scoped client SELF-collision route established by the source review.
+ */
+@MechanicType
+public interface CollisionQueryShapeHook extends VersionedMechanic {
+    Optional<Encoding> encode(AABB bounds);
+
+    enum Kind {
+        EMPTY,
+        FULL_CUBE,
+        DISCRETE,
+        RAW
+    }
+
+    /**
+     * Exact old Shapes.create(AABB) result description. For DISCRETE, each axis
+     * identifies its grid resolution and filled cell interval [minCell, maxCell).
+     * For RAW, axis endpoints are the exact input bounds and the remaining fields
+     * are -1. EMPTY and FULL_CUBE preserve the old canonical-shape branches.
+     */
+    record Encoding(Kind kind, Axis x, Axis y, Axis z) {
+    }
+
+    record Axis(double min, double max, int bits, int minCell, int maxCell) {
+        public static Axis discrete(double min, double max, int bits, int minCell, int maxCell) {
+            return new Axis(min, max, bits, minCell, maxCell);
+        }
+
+        public static Axis raw(double min, double max) {
+            return new Axis(min, max, -1, -1, -1);
+        }
+    }
+}
