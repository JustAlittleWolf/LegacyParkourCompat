diff --git a/src/client/java/me/wolfii/legacyparkourcompat/change/v1_16_2/shape/LegacyCollisionQueryShape.java b/src/client/java/me/wolfii/legacyparkourcompat/change/v1_16_2/shape/LegacyCollisionQueryShape.java
